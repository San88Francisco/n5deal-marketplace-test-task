# MySQL (locally provided by docker compose, see docker-compose.yml)
DATABASE_URL="mysql://root:root@localhost:3306/n5deal"

# Secret used to sign session cookies. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

# Google Gemini. Optional: when absent, AI features fall back to the
# deterministic scoring engine and plain keyword search.
GEMINI_API_KEY=""
