generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  PLATFORM_MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  statusReason String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions            Session[]
  buyerProfile        BuyerProfile?
  sellerProfile       SellerProfile?
  assets              Asset[]
  favourites          Favourite[]
  buyerConversations  Conversation[]     @relation("BuyerConversations")
  sellerConversations Conversation[]     @relation("SellerConversations")
  messages            Message[]
  actionsPerformed    ModerationAction[] @relation("ModerationActor")
  actionsReceived     ModerationAction[] @relation("ModerationTargetUser")

  @@index([role, status])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Jurisdiction {
  code   String @id @db.VarChar(8)
  name   String
  region String

  assets         Asset[]
  buyerTargets   BuyerTargetJurisdiction[]
  sellerPresence SellerJurisdiction[]

  @@index([region])
  @@map("jurisdictions")
}

model LicenceCategory {
  code        String  @id @db.VarChar(32)
  name        String
  description String? @db.Text

  assets       Asset[]
  buyerTargets BuyerTargetCategory[]

  @@map("licence_categories")
}

enum InvestorType {
  STRATEGIC
  PRIVATE_EQUITY
  VENTURE_CAPITAL
  FAMILY_OFFICE
  ANGEL
  CORPORATE
  OTHER
}

enum AcquisitionTimeline {
  IMMEDIATE
  SHORT
  MEDIUM
  EXPLORING
}

model BuyerProfile {
  id     String @id @default(cuid())
  userId String @unique

  companyName  String
  headline     String  @db.VarChar(180)
  about        String  @db.Text
  websiteUrl   String?
  country      String  @db.VarChar(8)
  investorType InvestorType

  ticketMinEur Decimal @db.Decimal(18, 2)
  ticketMaxEur Decimal @db.Decimal(18, 2)

  timeline           AcquisitionTimeline @default(EXPLORING)
  wantsOperatingOnly Boolean             @default(false)
  proofOfFundsReady  Boolean             @default(false)
  investmentThesis   String?             @db.Text
  isPublished        Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetJurisdictions  BuyerTargetJurisdiction[]
  targetCategories     BuyerTargetCategory[]
  targetBusinessTypes  BuyerTargetBusinessType[]

  @@index([investorType])
  @@index([isPublished])
  @@map("buyer_profiles")
}

model BuyerTargetJurisdiction {
  buyerProfileId   String
  jurisdictionCode String @db.VarChar(8)

  buyerProfile BuyerProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  jurisdiction Jurisdiction @relation(fields: [jurisdictionCode], references: [code], onDelete: Cascade)

  @@id([buyerProfileId, jurisdictionCode])
  @@index([jurisdictionCode])
  @@map("buyer_target_jurisdictions")
}

model BuyerTargetCategory {
  buyerProfileId String
  categoryCode   String @db.VarChar(32)

  buyerProfile BuyerProfile    @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  category     LicenceCategory @relation(fields: [categoryCode], references: [code], onDelete: Cascade)

  @@id([buyerProfileId, categoryCode])
  @@index([categoryCode])
  @@map("buyer_target_categories")
}

model BuyerTargetBusinessType {
  buyerProfileId String
  businessType   BusinessType

  buyerProfile BuyerProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)

  @@id([buyerProfileId, businessType])
  @@index([businessType])
  @@map("buyer_target_business_types")
}

enum SellerType {
  OWNER
  BROKER
  ADVISORY_FIRM
}

model SellerProfile {
  id     String @id @default(cuid())
  userId String @unique

  companyName String
  headline    String     @db.VarChar(180)
  about       String     @db.Text
  websiteUrl  String?
  country     String     @db.VarChar(8)
  sellerType  SellerType
  isVerified  Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatesIn SellerJurisdiction[]

  @@map("seller_profiles")
}

model SellerJurisdiction {
  sellerProfileId  String
  jurisdictionCode String @db.VarChar(8)

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  jurisdiction  Jurisdiction  @relation(fields: [jurisdictionCode], references: [code], onDelete: Cascade)

  @@id([sellerProfileId, jurisdictionCode])
  @@index([jurisdictionCode])
  @@map("seller_jurisdictions")
}

enum AssetStatus {
  DRAFT
  PUBLISHED
  UNDER_OFFER
  SOLD
  SUSPENDED
  ARCHIVED
}

enum LicenceStatus {
  ACTIVE
  IN_APPLICATION
  DORMANT
}

enum BusinessType {
  PAYMENT
  FINTECH
  CRYPTO
  BANKING
  FOREX
  GAMING
  OTHER
}

enum AssetFeatureCode {
  STAFF
  OFFICE
  BANK_ACCOUNTS
  MULTI_CURRENCY
  SOFTWARE_PLATFORM
  PAYMENT_RAILS
  CLIENT_BASE
  SECURITY_AUDIT
}

model Asset {
  id String @id @default(cuid())
  referenceCode Int    @unique @default(autoincrement())
  slug          String @unique
  sellerId      String

  title       String @db.VarChar(180)
  summary     String @db.VarChar(400)
  description String @db.Text

  jurisdictionCode String       @db.VarChar(8)
  categoryCode     String       @db.VarChar(32)
  businessType     BusinessType

  askingPriceEur Decimal? @db.Decimal(18, 2)
  revenueEur     Decimal? @db.Decimal(18, 2)
  ebitdaEur      Decimal? @db.Decimal(18, 2)

  licenceStatus     LicenceStatus
  regulator         String? @db.VarChar(120)
  licenceIssuedYear Int?
  yearEstablished   Int?
  employees         Int?
  activeClients     Int?
  hasPassporting    Boolean @default(false)
  reasonForSale     String? @db.Text

  status AssetStatus @default(DRAFT)
  isValidated Boolean   @default(false)
  publishedAt DateTime?
  viewCount   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller        User               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  jurisdiction  Jurisdiction       @relation(fields: [jurisdictionCode], references: [code])
  category      LicenceCategory    @relation(fields: [categoryCode], references: [code])
  features      AssetFeature[]
  favourites    Favourite[]
  conversations Conversation[]
  moderation    ModerationAction[] @relation("ModerationTargetAsset")

  @@index([status, publishedAt])
  @@index([jurisdictionCode])
  @@index([categoryCode])
  @@index([businessType])
  @@index([sellerId])
  @@index([askingPriceEur])
  @@map("assets")
}

model AssetFeature {
  assetId String
  code    AssetFeatureCode

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([assetId, code])
  @@index([code])
  @@map("asset_features")
}

model Favourite {
  userId    String
  assetId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([userId, assetId])
  @@index([assetId])
  @@map("favourites")
}

model Conversation {
  id       String  @id @default(cuid())
  buyerId  String
  sellerId String
  assetId  String?

  subject       String   @db.VarChar(200)
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  asset    Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([buyerId, sellerId, assetId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String    @db.Text
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum ModerationActionType {
  USER_SUSPEND
  USER_REINSTATE
  USER_REMOVE
  ASSET_SUSPEND
  ASSET_REINSTATE
  SELLER_VERIFY
}

model ModerationAction {
  id            String               @id @default(cuid())
  actorId       String
  type          ModerationActionType
  targetUserId  String?
  targetAssetId String?
  reason        String               @db.Text
  createdAt     DateTime             @default(now())

  actor       User   @relation("ModerationActor", fields: [actorId], references: [id])
  targetUser  User?  @relation("ModerationTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetAsset Asset? @relation("ModerationTargetAsset", fields: [targetAssetId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([targetAssetId, createdAt])
  @@index([createdAt])
  @@map("moderation_actions")
}
